# FREE engine by default: Valhalla (FOSSGIS), no API key or account needed.
# No environment variables are required to start.

# Optional: OpenRouteService (your own key) instead of Valhalla.
ORS_API_KEY=VOTRE_CLE_ORS_ICI

# 1 = analytic demo isochrones (no network calls, less accurate)
USE_DEMO_ROUTING=0

# Offline precompute
ORS_DELAY_MS=1200
MAX_ETABLISSEMENTS=60
VALHALLA_CLIENT_ID=onde-de-soins-demo

# Department to generate
DEPARTEMENT_CODE=58
DEPARTEMENT_NAME=Nièvre

# Optional: production data sources
# USE_FINESS=1
# FINESS_CSV_URL=https://static.data.gouv.fr/resources/.../stock.csv

# Optional: self-hosted ORS
# ORS_BASE_URL=http://localhost:8080/ors
